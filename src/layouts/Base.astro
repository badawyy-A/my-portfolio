---
import { Font } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Chrome from "../components/Chrome.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** the home page: full 3D scroll sequence when the device can take it, no separate footer */
  home?: boolean;
}

const {
  title = "Badawi, AI and full-stack engineer",
  description = "Badawi builds complete software with AI inside it: the model, the backend, the frontend and the deploy. Based in Cairo.",
  home = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0a0708" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />
    <script is:inline define:vars={{ home }}>
      // "js": scripts run, so reveal effects may start hidden.
      // With motion allowed and hardware WebGL, the home page gets the avatar scroll sequence:
      // "choreo" on large screens (with the loading screen), "choreo-m" on phones and tablets
      // (skipped on low-memory devices).
      (function () {
        var root = document.documentElement;
        root.classList.add("js");
        if (!home) return;
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        var small = window.innerWidth <= 1024;
        if (small && navigator.deviceMemory && navigator.deviceMemory < 4) return;
        try {
          var canvas = document.createElement("canvas");
          var options = { failIfMajorPerformanceCaveat: true };
          var gl = canvas.getContext("webgl2", options) || canvas.getContext("webgl", options);
          if (!gl) return;
          var lose = gl.getExtension("WEBGL_lose_context");
          if (lose) lose.loseContext();
          if (small) root.classList.add("choreo-m");
          else root.classList.add("choreo", "loading");
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link mono" href="#main">Skip to content</a>
    <slot name="before" />
    <Header />
    <Chrome caption={home} />
    <main id="main">
      <slot />
    </main>
    {!home && <Footer />}
    <script>
      import "../scripts/chrome";
      import "../scripts/motion";
    </script>
  </body>
</html>
