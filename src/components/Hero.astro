---
interface Props {
  name: string;
  role: string;
  intro: string;
  phrases: string[];
}

const { name, role, intro, phrases } = Astro.props;
const phraseList = phrases.slice(0, -1).join(", ") + " and " + phrases.at(-1);
---

<section class="landing" id="top" aria-labelledby="hero-title" data-hero>
  <div class="stage" aria-hidden="true">
    <div class="rim-wrap"><div class="rim"></div></div>
    <picture class="poster">
      <source media="(max-width: 48rem)" srcset="/images/avatar-narrow.webp" width="668" height="1046" />
      <img src="/images/avatar-wide.webp" alt="" width="870" height="1250" fetchpriority="high" />
    </picture>
    <slot name="avatar" />
    <div class="fade"></div>
  </div>

  <div class="landing-container">
    <div class="landing-intro">
      <h1 id="hero-title" data-intro="chars">
        <span class="hello">Hello, I'm</span>
        <span class="name">{name.toUpperCase()}</span>
      </h1>
      <p class="mono role" data-intro="fade">{role}</p>
    </div>

    <div class="landing-info">
      <p class="lead" aria-hidden="true" data-intro="chars">I build</p>
      <p class="visually-hidden">I build {phraseList}.</p>
      <div class="cycle" aria-hidden="true" data-phrases={JSON.stringify(phrases)} data-intro="rise">
        <span class="line line-1">{phrases[0]}</span>
        <span class="line line-2">{phrases[1 % phrases.length]}</span>
      </div>
      <p class="intro" data-intro="fade">{intro}</p>
    </div>
  </div>
</section>

<style>
  .landing {
    position: relative;
    min-height: 100svh;
    isolation: isolate;
  }

  .stage {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* glow behind the shoulders */
  .rim {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background-color: #d9455f;
    box-shadow: inset 66px 35px 85px 0 rgb(107 20 39 / 0.8);
    filter: blur(50px);
    transform: translate(-50%, 55%) scale(1.4);
  }

  .rim-wrap {
    position: absolute;
    inset: 0;
  }

  /* with the full sequence the glow rises once the loading screen is gone */
  :global(html.choreo) .rim {
    opacity: 0;
    transform: translate(-50%, 100%) scale(1.4);
    transition:
      opacity 2s var(--ease-out) 0.2s,
      transform 2s var(--ease-out) 0.2s;
  }

  :global(html.choreo:not(.loading)) [data-avatar="ready"] .rim,
  :global(html.choreo:not(.loading) [data-avatar="ready"]) .rim {
    opacity: 1;
    transform: translate(-50%, 55%) scale(1.4);
  }

  /* static render of the avatar: shown while the 3D loads, and when WebGL is off */
  .poster img {
    position: absolute;
    top: 0;
    left: 50%;
    width: auto;
    height: 100%;
    max-width: none;
    translate: -50% 0;
    transition: opacity 900ms var(--ease-out);
  }

  :global([data-avatar="ready"]) .poster img {
    opacity: 0;
  }

  .stage :global(.avatar-canvas) {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 900ms var(--ease-out);
  }

  .stage :global(.avatar-canvas.is-ready) {
    opacity: 1;
  }

  .fade {
    position: absolute;
    inset: auto 0 0;
    height: 35%;
    background: linear-gradient(to bottom, transparent, var(--bg) 85%);
  }

  /* large screens with the full scroll sequence: the avatar stays fixed while the page moves */
  :global(html.choreo) .stage {
    position: fixed;
    height: 100vh;
    z-index: 1;
  }

  :global(html.choreo) .fade {
    display: none;
  }

  /* Jarvis outside the hero canvas: his speech bubble, the tap target over him, the small canvas he
     is drawn in on the section headings, and the sound button. Rendered at the end of the page by
     the avatar island, which moves them with him every frame. */
  :global(.jarvis-bubble) {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 35;
    width: max-content;
    max-width: min(17rem, calc(100vw - 24px));
    padding: 0.65rem 0.9rem 0.75rem;
    border: 1px solid rgb(217 69 95 / 0.35);
    border-radius: 14px;
    background: rgb(20 12 14 / 0.92);
    color: var(--fg);
    font-size: 0.95rem;
    line-height: 1.4;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s var(--ease-out);
  }

  :global(.jarvis-bubble.is-on) {
    opacity: 1;
  }

  @media (max-width: 600px) {
    :global(.jarvis-bubble) {
      max-width: min(15rem, calc(100vw - 24px));
      font-size: 0.875rem;
    }
  }

  /* the tail points at him: down from above his head, up from below his feet, or sideways */
  :global(.jarvis-bubble)::after {
    content: "";
    position: absolute;
    top: 100%;
    left: var(--tail, 50%);
    width: 12px;
    height: 12px;
    border-right: 1px solid rgb(217 69 95 / 0.35);
    border-bottom: 1px solid rgb(217 69 95 / 0.35);
    background: rgb(20 12 14);
    transform: translate(-50%, -50%) rotate(45deg);
  }

  :global(.jarvis-bubble[data-side="below"])::after {
    top: auto;
    bottom: 100%;
    transform: translate(-50%, 50%) rotate(225deg);
  }

  :global(.jarvis-bubble[data-side="right"])::after {
    top: var(--tail, 50%);
    left: 0;
    transform: translate(-50%, -50%) rotate(135deg);
  }

  :global(.jarvis-bubble[data-side="left"])::after {
    top: var(--tail, 50%);
    left: 100%;
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  /* phones: like subtitles, across the bottom of the screen */
  :global(.jarvis-bubble[data-side="caption"]) {
    width: calc(100vw - 24px);
    max-width: none;
    background: rgb(20 12 14 / 0.98);
  }

  :global(.jarvis-bubble[data-side="caption"])::after {
    display: none;
  }

  :global(.jarvis-bubble[data-side="caption"] [data-word]:not(.in-sentence)) {
    display: none;
  }

  :global(.jarvis-name) {
    display: block;
    margin-bottom: 0.25rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* the words light up as he says them */
  :global(.jarvis-line [data-word]) {
    opacity: 0.4;
    transition: opacity 0.15s linear;
  }

  :global(.jarvis-line .is-said) {
    opacity: 1;
  }

  :global(.jarvis-hit) {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 35;
    padding: 0;
    border: 0;
    border-radius: 40%;
    background: transparent;
    cursor: pointer;
  }

  :global(.jarvis-hit:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  :global(.jarvis-stage) {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 34;
    pointer-events: none;
  }

  /* bottom right, level with the social column */
  :global(.jarvis-sound) {
    position: fixed;
    right: max(20px, calc((100vw - min(var(--c-width), var(--c-max))) / 2));
    bottom: 26px;
    z-index: 45;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: rgb(20 12 14 / 0.85);
    color: var(--muted);
    cursor: pointer;
    transition:
      color 0.3s var(--ease-out),
      border-color 0.3s var(--ease-out);
  }

  :global(.jarvis-sound svg) {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  :global(.jarvis-sound[aria-pressed="true"]) {
    border-color: rgb(217 69 95 / 0.45);
    color: var(--fg);
  }

  :global(.jarvis-sound:hover),
  :global(.jarvis-sound:focus-visible) {
    border-color: var(--accent);
    color: var(--accent);
  }

  :global(.jarvis-sound:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  :global(html.loading .jarvis-sound) {
    display: none;
  }

  .landing-container {
    position: relative;
    z-index: 2;
    width: var(--c-width);
    max-width: var(--c-max);
    min-height: 100svh;
    margin-inline: auto;
  }

  h1 {
    display: flex;
    flex-direction: column;
    gap: 0.35em;
    font-size: var(--text-base);
    font-weight: 400;
    letter-spacing: 0;
  }

  .hello,
  .lead {
    color: var(--accent);
    font-size: 22px;
    font-weight: 400;
    letter-spacing: 0.06em;
    line-height: 1.1;
  }

  .name {
    font-size: clamp(3rem, 6vw, 7.5rem);
    font-weight: 900;
    line-height: 0.85;
    letter-spacing: var(--tracking-tight);
  }

  .role {
    margin-top: 1.2rem;
    color: var(--muted);
  }

  .cycle {
    position: relative;
    display: flex;
    flex-direction: column;
    margin-top: 0.35em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .line {
    display: flex;
    overflow: hidden;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.05;
  }

  .line :global(.char) {
    display: inline-block;
    white-space: pre;
  }

  /* first line sits behind the second, fading into the background */
  .line-1 {
    position: relative;
    color: var(--accent);
    font-size: clamp(2rem, 3.4vw, 4.4rem);
  }

  .line-1::after {
    content: "";
    position: absolute;
    inset: 0 0 -20% 0;
    z-index: 3;
    background-image: linear-gradient(0deg, var(--bg) 40%, rgb(10 7 8 / 0) 110%);
  }

  .line-2 {
    position: relative;
    z-index: 4;
    margin-top: -0.45em;
    font-size: clamp(1.6rem, 2.7vw, 3.6rem);
  }

  .intro {
    max-width: 22rem;
    margin-top: 1.4rem;
    color: var(--muted);
    font-size: var(--text-sm);
  }

  @media (min-width: 1025px) {
    .landing,
    .landing-container {
      height: 100vh;
      min-height: 0;
    }

    .landing-intro {
      position: absolute;
      top: 42%;
      right: 66%;
      translate: 0 -50%;
    }

    .landing-info {
      position: absolute;
      top: 52%;
      left: 66%;
      translate: 0 -50%;
    }
  }

  @media (min-width: 1200px) {
    .landing-intro {
      right: 69%;
    }

    .landing-info {
      left: 69%;
    }
  }

  @media (min-width: 1600px) {
    .hello,
    .lead {
      font-size: 32px;
    }
  }

  /* phones and tablets: avatar on top, text below */
  @media (max-width: 1024px) {
    /* the avatar area fades out at its bottom edge instead of ending on a hard line */
    .stage {
      bottom: auto;
      height: 62svh;
      -webkit-mask-image: linear-gradient(to bottom, #000 60%, transparent 97%);
      mask-image: linear-gradient(to bottom, #000 60%, transparent 97%);
    }

    .fade {
      display: none;
    }

    /* phones and tablets with the scroll sequence: the avatar stays at the top while the page moves */
    :global(html.choreo-m) .stage {
      position: fixed;
      top: 0;
      right: 0;
      left: 0;
      z-index: 1;
    }

    .rim {
      top: 20%;
      opacity: 0.7;
      transform: translate(-50%, 30%) scale(0.95);
    }

    /* with the scroll sequence the glow rises once the loading screen is gone, as on large screens */
    :global(html.choreo-m) .rim {
      opacity: 0;
      transform: translate(-50%, 80%) scale(0.95);
      transition:
        opacity 2s var(--ease-out) 0.2s,
        transform 2s var(--ease-out) 0.2s;
    }

    :global(html.choreo-m:not(.loading)) [data-avatar="ready"] .rim,
    :global(html.choreo-m:not(.loading) [data-avatar="ready"]) .rim {
      opacity: 0.7;
      transform: translate(-50%, 30%) scale(0.95);
    }

    .landing-container {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      gap: 2rem;
      padding-top: 52svh;
      padding-bottom: 3rem;
    }

    .name {
      font-size: min(19vw, 7rem);
    }

    .line-1 {
      font-size: clamp(1.8rem, 7vw, 3.4rem);
    }

    .line-2 {
      font-size: clamp(1.5rem, 6vw, 2.8rem);
    }
  }
</style>
