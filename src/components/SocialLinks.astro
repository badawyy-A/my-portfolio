---
import Todo from "./Todo.astro";
import { contactLinks, type Links } from "../lib/content";

interface Props {
  links: Links;
  only?: string[];
}

const { links, only } = Astro.props;
const items = contactLinks(links).filter((link) => !only || only.includes(link.label));
---

<ul class="social">
  {items.map((link) => (
    <li>
      {link.todo ? (
        <span class="mono label">{link.label} <Todo text="[TODO]" /></span>
      ) : (
        <a class="mono label" href={link.href} rel={link.label === "Email" ? undefined : "me noopener"}>
          {link.label}
        </a>
      )}
    </li>
  ))}
</ul>

<style>
  .social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    padding: 0;
    list-style: none;
  }

  .label {
    color: var(--muted);
  }

  a.label {
    text-decoration: none;
    transition: color var(--duration) var(--ease-out);
  }

  a.label:hover {
    color: var(--fg);
  }
</style>
