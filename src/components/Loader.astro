---
// Loading screen for the full 3D experience (html.choreo on large screens, html.choreo-m on phones).
// It counts up while the avatar loads, then waits for the visitor to press Enter: that click is what
// lets Jarvis talk, since browsers only allow sound after one. The page behind is complete and stays
// inert (out of reach for keyboards and screen readers) until then; see scripts/loader.ts.
const words = ["AI engineer", "Full-stack engineer", "AI engineer", "Full-stack engineer"];
---

<div class="loader">
  <div class="loader-header" aria-hidden="true">
    <span class="loader-title">badawi.dev</span>
  </div>
  <div class="loader-screen">
    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        {[...words, ...words].map((word) => <span>{word}</span>)}
      </div>
    </div>
    <div class="wrap">
      <div class="hover" aria-hidden="true"></div>
      <button class="button" type="button" disabled aria-describedby="loader-hint">
        <span class="counter" aria-hidden="true">
          <span class="counter-in">
            <span class="counter-text">Loading <span data-percent>0%</span></span>
          </span>
          <span class="caret"></span>
        </span>
        <span class="welcome"><span>Enter</span></span>
      </button>
    </div>
    <p class="hint mono" id="loader-hint">Best with sound on</p>
  </div>
</div>

<style>
  .loader {
    display: none;
  }

  :global(html.choreo) .loader,
  :global(html.choreo-m) .loader {
    display: block;
  }

  .loader-header {
    position: fixed;
    top: 0;
    left: 50%;
    z-index: 1001;
    display: flex;
    width: var(--c-width);
    max-width: var(--c-max);
    padding-block: 35px;
    color: var(--bg);
    translate: -50% 0;
  }

  .loader-title {
    font-size: 18px;
    font-weight: 800;
  }

  .loader-screen {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100vh;
    background-color: var(--fg);
    transition: opacity 600ms var(--ease-out);
  }

  .loader:global(.is-gone) .loader-screen,
  .loader:global(.is-gone) .loader-header {
    opacity: 0;
    pointer-events: none;
  }

  .marquee {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    overflow: hidden;
    color: var(--bg);
    font-size: clamp(3rem, 1rem + 5vw, 6.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    white-space: nowrap;
    translate: 0 -50%;
  }

  .marquee-track {
    display: inline-flex;
    animation: marquee 30s linear infinite;
  }

  .marquee span {
    position: relative;
    padding-inline: 50px;
  }

  .marquee span::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 0;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background-color: var(--accent);
    translate: -50% -50%;
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  .wrap {
    --l-size: 210px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
    overflow: hidden;
    border-radius: 100px;
    background-color: var(--bg);
    box-shadow: 0 15px 15px 0 rgb(0 0 0 / 0.2);
    transition: 0.8s ease-in-out 0.2s;
  }

  .loader:global(.is-clicked) .wrap {
    min-width: calc(100vw + 5000px);
    min-height: calc(100vh + 500px);
    border-radius: 5000px;
    box-shadow: none;
    transition-delay: 0ms;
    transition-timing-function: cubic-bezier(0.33, 0.11, 1, 0.72);
  }

  .hover {
    position: absolute;
    top: var(--mouse-y, 50%);
    left: var(--mouse-x, 50%);
    width: 250px;
    height: 120px;
    border-radius: 50%;
    background-color: var(--accent);
    filter: blur(30px);
    translate: -50% -50%;
    transition: opacity 500ms;
  }

  .loader:global(.is-clicked) .hover {
    opacity: 0;
  }

  .button {
    position: relative;
    z-index: 9;
    display: block;
    padding: 30px 70px;
    overflow: hidden;
    border: 0;
    border-radius: 100px;
    background-color: var(--bg);
    color: var(--fg);
    font-family: inherit;
    font-size: 25px;
    font-weight: 500;
  }

  .button:enabled {
    cursor: pointer;
  }

  .button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
  }

  .loader:global(.is-complete) .loader-screen {
    cursor: pointer;
  }

  .hint {
    position: absolute;
    top: calc(50% + 70px);
    left: 50%;
    color: var(--bg);
    opacity: 0;
    translate: -50% 0;
    transition: opacity 0.6s var(--ease-out) 0.6s;
  }

  .loader:global(.is-complete) .hint {
    opacity: 0.7;
  }

  .loader:global(.is-clicked) .hint {
    opacity: 0;
    transition-delay: 0s;
  }

  .loader:global(.is-clicked) .button {
    overflow: visible;
  }

  .counter {
    position: absolute;
    top: 50%;
    left: 70px;
    z-index: 9;
    width: 100%;
    max-width: var(--l-size);
    translate: 0 -50%;
    transition: 1s;
  }

  .loader:global(.is-complete) .counter {
    max-width: 0;
  }

  .counter-in {
    position: relative;
    display: block;
    overflow: hidden;
    background-color: var(--bg);
    text-transform: uppercase;
  }

  .counter-text {
    position: relative;
    display: block;
    width: var(--l-size);
  }

  .counter-text span {
    position: absolute;
    top: 50%;
    right: 0;
    font-weight: 300;
    opacity: 0.7;
    translate: 0 -50%;
  }

  .caret {
    position: absolute;
    top: 50%;
    right: 0;
    width: 15px;
    height: 25px;
    background-color: var(--fg);
    translate: 100% -50%;
    animation: blink 1s linear infinite;
  }

  .loader:global(.is-complete) .caret {
    animation: caret-done 0.3s 1s forwards;
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 0;
    }
    25%,
    75% {
      opacity: 1;
    }
  }

  @keyframes caret-done {
    to {
      opacity: 0;
    }
  }

  .welcome {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--l-size);
    letter-spacing: 2px;
    text-transform: uppercase;
    transition: 1s;
  }

  .loader:global(.is-clicked) .welcome span {
    opacity: 0;
    translate: 0 100px;
    transition: 1s;
  }

  @media (max-width: 1399px) {
    .wrap {
      --l-size: 145px;
    }

    .button {
      padding: 20px 50px;
      font-size: 18px;
    }

    .counter {
      left: 50px;
    }
  }
</style>
