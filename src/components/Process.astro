---
import SectionHead from "./SectionHead.astro";

interface Props {
  steps: { title: string; text: string }[];
}
const { steps } = Astro.props;
---

<section id="process" class="section container" aria-labelledby="process-title">
  <SectionHead id="process" label="How I deliver" title="The same four steps on every project." />
  <ol class="steps">
    {steps.map((step, i) => (
      <li data-reveal>
        <p class="mono index">{String(i + 1).padStart(2, "0")}</p>
        <h3>{step.title}</h3>
        <p class="text">{step.text}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-8);
    padding: 0;
    list-style: none;
  }

  li {
    position: relative;
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
  }

  /* arrow head on the line, pointing to the next step */
  li:not(:last-child)::after {
    content: "";
    position: absolute;
    top: -4px;
    right: calc(var(--space-8) / -2 - 4px);
    width: 7px;
    height: 7px;
    border-top: 1px solid var(--accent);
    border-right: 1px solid var(--accent);
    rotate: 45deg;
  }

  .index {
    color: var(--accent);
  }

  h3 {
    margin-top: var(--space-4);
    font-size: var(--text-2xl);
  }

  .text {
    margin-top: var(--space-3);
    color: var(--muted);
  }

  @media (max-width: 56rem) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
      row-gap: var(--space-12);
    }

    li:nth-child(2)::after {
      display: none;
    }
  }

  @media (max-width: 34rem) {
    .steps {
      grid-template-columns: 1fr;
      row-gap: var(--space-8);
    }

    li::after {
      display: none;
    }
  }
</style>
