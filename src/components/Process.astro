---
interface Props {
  steps: { title: string; text: string }[];
}
const { steps } = Astro.props;
---

<section class="process section-container" id="process" aria-labelledby="process-title">
  <h2 id="process-title" class="title">How I <span>deliver</span></h2>
  <ol class="steps" data-frames>
    {steps.map((step, i) => (
      <li class="step">
        <span class="corner" aria-hidden="true"></span>
        <p class="mono index">{String(i + 1).padStart(2, "0")}</p>
        <h3>{step.title}</h3>
        <p class="text">{step.text}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .process {
    position: relative;
    z-index: 2;
    padding-block: 120px;
  }

  h2 {
    margin-bottom: 70px;
    font-size: 70px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  h2 span {
    color: var(--accent);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 40px;
    padding: 0;
    list-style: none;
  }

  .step {
    position: relative;
    padding: 34px 28px 40px;
    border: 1px dashed rgb(237 230 227 / 0.22);
  }

  /* arrow to the next step */
  .step:not(:last-child) > .text::after {
    content: "→";
    position: absolute;
    top: 50%;
    right: -30px;
    color: var(--accent);
    font-family: var(--font-mono);
    translate: 0 -50%;
  }

  /* bracket corners, same as the What I build cards */
  .step::before,
  .step::after,
  .corner::before,
  .corner::after {
    content: "";
    position: absolute;
    width: 10px;
    height: 10px;
    border: 4px solid var(--fg);
  }

  .step::before {
    top: -2px;
    left: -2px;
    border-right: none;
    border-bottom: none;
  }

  .step::after {
    bottom: -2px;
    left: -2px;
    border-top: none;
    border-right: none;
  }

  .corner::before {
    top: -2px;
    right: -2px;
    border-bottom: none;
    border-left: none;
  }

  .corner::after {
    right: -2px;
    bottom: -2px;
    border-top: none;
    border-left: none;
  }

  .index {
    color: var(--accent);
  }

  h3 {
    margin-top: 1.4rem;
    font-size: 34px;
    font-weight: 600;
    text-transform: uppercase;
  }

  .text {
    margin-top: 0.8rem;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.5;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .steps .step {
      opacity: 0;
    }

    .steps:global(.is-in) .step {
      animation: step-in 0.6s var(--ease-out) forwards;
    }

    .steps:global(.is-in) .step:nth-child(2) {
      animation-delay: 0.12s;
    }

    .steps:global(.is-in) .step:nth-child(3) {
      animation-delay: 0.24s;
    }

    .steps:global(.is-in) .step:nth-child(4) {
      animation-delay: 0.36s;
    }
  }

  @keyframes step-in {
    from {
      opacity: 0;
      translate: 0 24px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  @media (max-width: 1400px) {
    h2 {
      font-size: 50px;
    }

    h3 {
      font-size: 26px;
    }
  }

  @media (max-width: 1024px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .step:nth-child(2) > .text::after {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .process {
      padding-block: 70px;
    }

    h2 {
      margin-bottom: 40px;
      font-size: 42px;
    }

    .steps {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .step > .text::after {
      display: none;
    }
  }
</style>
