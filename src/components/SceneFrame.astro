---
// Box that holds a project's 3D scene. Without WebGL it stays a quiet empty surface.
interface Props {
  scene: string;
  size?: "card" | "page";
}
const { scene, size = "card" } = Astro.props;
---

<div class:list={["frame", size]} data-scene={scene} aria-hidden="true">
  <slot />
</div>

<style>
  .frame {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(60% 70% at 50% 55%, rgb(107 20 39 / 0.28), transparent 70%),
      var(--surface);
    border: 1px solid var(--line);
    border-radius: 4px;
  }

  .card {
    aspect-ratio: 4 / 3;
  }

  .page {
    aspect-ratio: 16 / 9;
  }

  @media (max-width: 40rem) {
    .page {
      aspect-ratio: 4 / 3;
    }
  }
</style>
