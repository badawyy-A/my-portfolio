---
// Box that holds a project's 3D scene. Without WebGL it stays a quiet empty surface.
import ProjectScene from "./three/ProjectScene";

interface Props {
  scene: string;
  size?: "card" | "page";
}
const { scene, size = "card" } = Astro.props;
---

<div class:list={["frame", size]} data-scene={scene} aria-hidden="true">
  <ProjectScene client:visible scene={scene} />
</div>

<style>
  .frame {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(60% 70% at 50% 55%, rgb(107 20 39 / 0.28), transparent 70%),
      var(--surface);
    border: 1px solid var(--line);
    border-radius: 4px;
  }

  .frame :global(.scene-canvas) {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 700ms var(--ease-out);
  }

  .frame :global(.scene-canvas.is-ready) {
    opacity: 1;
  }

  .card {
    aspect-ratio: 4 / 3;
  }

  .page {
    aspect-ratio: 16 / 9;
  }

  @media (max-width: 40rem) {
    .page {
      aspect-ratio: 4 / 3;
    }
  }
</style>
