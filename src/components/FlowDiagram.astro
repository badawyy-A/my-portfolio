---
// "How it works" as a simple left-to-right flow of steps.
interface Props {
  steps: string[];
}
const { steps } = Astro.props;
---

<figure class="flow" data-reveal style={`--steps: ${steps.length}`}>
  <ol aria-label="How it works, in order">
    {steps.map((step, i) => (
      <li>
        <span class="mono index">{String(i + 1).padStart(2, "0")}</span>
        <span class="step">{step}</span>
      </li>
    ))}
  </ol>
</figure>

<style>
  .flow {
    margin-top: var(--space-12);
  }

  ol {
    display: grid;
    grid-template-columns: repeat(var(--steps), minmax(0, 1fr));
    gap: var(--space-6);
    padding: 0;
    list-style: none;
  }

  li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 4px;
  }

  /* connector to the next step */
  li:not(:last-child)::after {
    content: "→";
    position: absolute;
    top: 50%;
    right: calc(var(--space-6) / -2);
    translate: 50% -50%;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .index {
    color: var(--accent);
  }

  .step {
    font-weight: 600;
    line-height: 1.3;
  }

  @media (max-width: 52rem) {
    ol {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    li:not(:last-child)::after {
      content: "↓";
      top: auto;
      bottom: calc(var(--space-6) / -2);
      right: auto;
      left: var(--space-6);
      translate: 0 50%;
    }
  }
</style>
