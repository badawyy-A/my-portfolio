---
import ProjectCard from "./ProjectCard.astro";
import { getProjects } from "../lib/content";

const projects = await getProjects();
---

<section class="work-section" id="work" aria-labelledby="work-title">
  <div class="work-container section-container">
    <h2 id="work-title">My <span>work</span></h2>
    <div class="work-flex">
      {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
      <div class="work-box work-cta">
        <p class="cta-title">Something to build?</p>
        <p class="cta-text">Tell me what it should do, and I will tell you how I would build it.</p>
        <a class="cta-button" href="#contact">Get in touch →</a>
      </div>
    </div>
  </div>
</section>

<style>
  .work-section {
    position: relative;
    z-index: 2;
  }

  .work-container {
    display: flex;
    flex-direction: column;
  }

  h2 {
    margin: 50px 0 20px;
    font-size: 36px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  h2 > span {
    color: var(--accent);
  }

  .work-flex {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .work-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 40px 20px;
    text-align: center;
  }

  .cta-title {
    font-size: 30px;
    font-weight: 600;
  }

  .cta-text {
    max-width: 26ch;
    color: var(--muted);
  }

  .cta-button {
    display: inline-block;
    margin-top: 10px;
    padding: 15px 35px;
    border-radius: 30px;
    background: var(--accent);
    color: var(--bg);
    font-weight: 600;
    text-decoration: none;
    transition:
      scale 0.3s var(--ease-out),
      box-shadow 0.3s var(--ease-out);
  }

  .cta-button:hover {
    color: var(--bg);
    scale: 1.05;
    box-shadow: 0 10px 30px rgb(217 69 95 / 0.4);
  }

  @media (min-width: 769px) {
    h2 {
      margin: 100px 0 40px;
      font-size: 56px;
    }
  }

  /* pinned horizontal carousel */
  :global(html.pin-work) .work-section {
    height: 100vh;
  }

  :global(html.pin-work) .work-container {
    height: 100%;
  }

  :global(html.pin-work) h2 {
    margin: 100px 0 40px;
    font-size: 70px;
  }

  :global(html.pin-work) .work-flex {
    flex-direction: row;
    height: 100%;
    margin-left: -80px;
    padding-right: 120px;
  }

  :global(html.pin-work) .work-flex::before,
  :global(html.pin-work) .work-flex::after {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    width: 50000vw;
    height: 1px;
    background-color: var(--line);
    translate: -50% 0;
  }

  :global(html.pin-work) .work-flex::after {
    top: 100%;
  }

  :global(html.pin-work) .work-cta {
    flex-shrink: 0;
    width: 480px;
  }

  @media (max-width: 1400px) {
    :global(html.pin-work) h2 {
      font-size: 50px;
    }

    :global(html.pin-work) .work-flex {
      margin-left: -50px;
      padding-right: 75px;
    }
  }

  @media (max-height: 900px) {
    :global(html.pin-work) h2 {
      margin: 80px 0 24px;
      font-size: 56px;
    }
  }
</style>
