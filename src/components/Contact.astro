---
import Icon from "./Icon.astro";
import NewTabNote from "./NewTabNote.astro";
import type { Links } from "../lib/content";
import { newTab } from "../lib/links";

interface Props {
  line: string;
  links: Links;
  location: string;
}
const { line, links, location } = Astro.props;
const social = [
  { label: "GitHub", href: links.github },
  { label: "LinkedIn", href: links.linkedin },
  { label: "WhatsApp", href: links.whatsapp },
];
const year = new Date().getFullYear();
---

<section class="contact-section section-container" id="contact" aria-labelledby="contact-title">
  <h2 id="contact-title" data-reveal>{line}</h2>
  <div class="contact-flex">
    <div class="contact-box" data-reveal>
      <h3>Email</h3>
      <p class="email"><a href={`mailto:${links.email}`} {...newTab()}>{links.email}<NewTabNote /></a></p>
      <h3>Location</h3>
      <p>{location}</p>
    </div>
    <div class="contact-box" data-reveal>
      <h3>Social</h3>
      {social.map((item) => (
        <a class="social" href={item.href} {...newTab("me")}>
          {item.label} <Icon name="arrow" size={18} /><NewTabNote />
        </a>
      ))}
    </div>
    <div class="contact-box" data-reveal>
      <p class="credit">AI &amp; full-stack engineer<br /><span>Badawi</span></p>
      <p class="mono copy">&copy; {year} Badawi &middot; {location}</p>
    </div>
  </div>
</section>

<style>
  .contact-section {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    min-height: 60vh;
    margin-top: 50px;
    padding-bottom: 50px;
  }

  h2 {
    max-width: 18ch;
    margin-bottom: 40px;
    font-size: 32px;
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .contact-flex {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .contact-box {
    display: flex;
    flex-direction: column;
  }

  h3 {
    margin-top: 20px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 500;
  }

  .contact-box > p {
    margin-top: 8px;
    font-size: 15px;
  }

  .email {
    user-select: all;
  }

  .email a {
    color: var(--fg);
  }

  .email a:hover {
    color: var(--accent);
  }

  .social {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    width: fit-content;
    margin-top: 10px;
    border-bottom: 1px solid var(--muted);
    color: var(--fg);
    font-size: 18px;
    text-decoration: none;
  }

  .social:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .credit {
    font-size: 18px;
    line-height: 1.3;
  }

  .credit span {
    color: var(--accent);
  }

  .copy {
    margin-top: 10px;
    color: var(--muted);
  }

  @media (min-width: 600px) {
    h2 {
      font-size: 40px;
    }
  }

  @media (min-width: 900px) {
    .contact-section {
      margin-top: 0;
      padding-bottom: 150px;
    }

    h2 {
      font-size: 48px;
    }

    .contact-flex {
      flex-direction: row;
      justify-content: space-between;
      gap: 2rem;
    }

    h3:first-child {
      margin-top: 0;
    }

    .social {
      font-size: 22px;
    }

    .credit {
      font-size: 20px;
    }
  }

  @media (min-width: 1300px) {
    h2 {
      font-size: 60px;
    }

    .social {
      font-size: 24px;
    }

    .credit {
      font-size: 22px;
    }
  }
</style>
