---
// on the home page the links stay in-page so smooth scrolling handles them
const base = Astro.url.pathname === "/" ? "" : "/";
const links = [
  { href: `${base}#work`, label: "Work" },
  { href: `${base}#about`, label: "About" },
  { href: `${base}#experience`, label: "Experience" },
  { href: `${base}#contact`, label: "Contact" },
];
---

<header class="site-header">
  <div class="container inner">
    <a class="wordmark" href="/">badawi.dev</a>
    <nav aria-label="Main">
      <ul>
        {links.map((link) => (
          <li>
            <a class="mono" href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: absolute;
    inset: 0 0 auto;
    z-index: 10;
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--header-height);
  }

  .wordmark {
    color: var(--fg);
    font-weight: 800;
    font-size: var(--text-base);
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  nav {
    min-width: 0;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-1) var(--space-6);
    padding: 0;
    list-style: none;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
    transition: color var(--duration) var(--ease-out);
  }

  nav a:hover {
    color: var(--fg);
  }

  @media (max-width: 30rem) {
    ul {
      gap: var(--space-1) var(--space-3);
    }
  }

  @media (max-width: 24rem) {
    .inner {
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: var(--space-1);
      padding-block: var(--space-3);
    }

    ul {
      justify-content: flex-start;
    }
  }
</style>
