---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import SceneFrame from "../../components/SceneFrame.astro";
import FlowDiagram from "../../components/FlowDiagram.astro";
import Text from "../../components/Text.astro";
import NewTabNote from "../../components/NewTabNote.astro";
import { newTab } from "../../lib/links";
import { getProjects } from "../../lib/content";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { title, summary, stack, layers, flow, scene } = project.data;
const { Content } = await render(project);
---

<Base title={`${title} · Badawi`} description={summary}>
  <article class="project">
    <header class="container intro">
      <a class="mono back" href="/#work" {...newTab()}>← All work<NewTabNote /></a>
      <p class="mono stack">{stack.join(" · ")}</p>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
    </header>

    <div class="container scene">
      <SceneFrame scene={scene} size="page" />
    </div>

    <div class="container body">
      <div class="prose">
        <Content />
      </div>
      <FlowDiagram steps={flow} />

      <section aria-labelledby="stack-title">
        <h2 id="stack-title">Stack</h2>
        <dl class="layers">
          {layers.map((layer) => (
            <div class="layer" data-reveal>
              <dt class="mono">{layer.name}</dt>
              <dd>
                {layer.items.map((item, i) => (
                  <>
                    {i > 0 && <span class="sep"> · </span>}
                    <Text value={item} />
                  </>
                ))}
              </dd>
            </div>
          ))}
        </dl>
      </section>

    </div>
  </article>
</Base>

<style>
  .intro {
    padding-top: calc(var(--header-height) + clamp(2rem, 1rem + 4vw, 5rem));
  }

  .back {
    color: var(--muted);
    text-decoration: none;
  }

  .back:hover {
    color: var(--fg);
  }

  .stack {
    margin-top: var(--space-12);
    color: var(--accent);
    text-transform: none;
    letter-spacing: 0;
  }

  h1 {
    margin-top: var(--space-4);
    max-width: 16ch;
    font-size: clamp(2.75rem, 1rem + 6vw, 7rem);
    font-weight: 900;
    line-height: 0.92;
  }

  .summary {
    margin-top: var(--space-6);
    max-width: 40ch;
    color: var(--muted);
    font-size: var(--text-lg);
  }

  .scene {
    margin-top: clamp(2.5rem, 2rem + 3vw, 5rem);
  }

  .body {
    padding-bottom: clamp(4rem, 2.5rem + 4.5vw, 7.5rem);
  }

  .body > * {
    max-width: 58rem;
  }

  .body h2,
  .prose :global(h2) {
    margin-top: clamp(3.5rem, 2.5rem + 3vw, 6rem);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.75rem);
  }

  .prose :global(p),
  .prose :global(ul) {
    margin-top: var(--space-6);
    max-width: 65ch;
  }

  .prose :global(ul) {
    padding-left: 1.1em;
  }

  .prose :global(li) {
    margin-top: var(--space-2);
  }

  .prose :global(li::marker) {
    color: var(--accent);
  }

  .prose :global(p + ul) {
    margin-top: var(--space-3);
  }

  .prose :global(strong) {
    font-weight: 700;
  }

  .layers {
    margin-top: var(--space-8);
  }

  .layer {
    display: grid;
    grid-template-columns: minmax(8rem, 1fr) 3fr;
    gap: var(--space-2) var(--space-6);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--line);
  }

  dt {
    color: var(--muted);
  }

  dd {
    margin: 0;
  }

  .sep {
    color: var(--muted);
  }

  @media (max-width: 40rem) {
    .layer {
      grid-template-columns: 1fr;
    }
  }
</style>
